FROM nvidia/cuda:13.0.1-devel-ubuntu22.04

LABEL maintainer="Elvis" description="FluxSR - Blackwell sm_120"

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Asia/Shanghai
ENV PYTHONUNBUFFERED=1

# 1. 移除可能导致超时的 NVIDIA 官方 apt 源
RUN rm -f /etc/apt/sources.list.d/cuda*.list && \
    rm -f /etc/apt/sources.list.d/nvidia*.list

# 2. 完整覆写 Ubuntu 22.04 (Jammy) 清华源 (使用 http 避免初始镜像的证书拦截)
RUN echo "deb http://mirrors.tuna.tsinghua.edu.cn/ubuntu/ jammy main restricted universe multiverse" > /etc/apt/sources.list && \
    echo "deb http://mirrors.tuna.tsinghua.edu.cn/ubuntu/ jammy-updates main restricted universe multiverse" >> /etc/apt/sources.list && \
    echo "deb http://mirrors.tuna.tsinghua.edu.cn/ubuntu/ jammy-backports main restricted universe multiverse" >> /etc/apt/sources.list && \
    echo "deb http://mirrors.tuna.tsinghua.edu.cn/ubuntu/ jammy-security main restricted universe multiverse" >> /etc/apt/sources.list

# 3. 更新并安装系统依赖 (注意为 ppa 添加 -y 自动确认)
RUN apt-get update && apt-get install -y --no-install-recommends \
        software-properties-common build-essential gcc g++ wget curl git \
        libgl1 libglib2.0-0 libgl1-mesa-glx ca-certificates \
    && add-apt-repository ppa:deadsnakes/ppa -y && \
    apt-get update && apt-get install -y --no-install-recommends \
        python3.10 python3.10-dev python3.10-distutils \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# 下载并配置 pip
RUN wget -q https://bootstrap.pypa.io/get-pip.py && \
    python3.10 get-pip.py && rm get-pip.py && \
    update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.10 1 && \
    update-alternatives --install /usr/bin/python python /usr/bin/python3.10 1

# 设置 pip 清华源
RUN pip config set global.index-url https://pypi.tuna.tsinghua.edu.cn/simple

# 安装 PyTorch 和 torchvision
RUN pip install --no-cache-dir torch==2.12.0 torchvision

# 安装 FluxSR 依赖
RUN pip install --no-cache-dir \
    pillow numpy scikit-image scikit-learn einops opencv-python matplotlib \
    wandb scipy tqdm torchmetrics fvcore lightning tensorboard \
    yacs joblib natsort h5py gdown addict future lmdb pyyaml requests yapf lpips ninja packaging

# 使用 .dockerignore 排除不必要的文件（如 .git, checkpoints/）
COPY . /workspace/

WORKDIR /workspace
CMD ["bash"]